# Test configuration for the review-gate end-to-end test (.github/workflows/review-gate-e2e.yml).
# Pins the model runtime so the test always exercises a real local SLM, independent of
# repository variables.
LLM_RUNTIME_IMAGE=ollama/ollama:0.40.11@sha256:dea72d1e22270fe095b68fdf756d2b489d615643c5a2eaebbc5f569181e322d8
LLM_MODEL=qwen2.5-coder:1.5b
LLM_PROFILE=balanced
# Rule findings the fixture must produce (deterministic floor), space separated.
EXPECTED_RULES=INJ-001 ERR-001 JAVA-001 JAVA-003
